{% extends 'base.html.twig' %}

{% block title %}Panel admin | TournamentFlow{% endblock %}

{% block body %}
    <div class="card">
        <div class="breadcrumbs">
            <a href="{{ path('app_home') }}">Inicio</a>
            <span class="crumb-sep">&gt;</span>
            <span>Panel admin</span>
        </div>

        <h1 class="title">Panel de administración</h1>
        <p class="subtitle">Gestiona juegos y torneos de toda la plataforma.</p>

        <h2 class="title" style="font-size: 24px; margin-top: 0;">Juegos</h2>
        <div class="actions-row" style="margin-top: 0; margin-bottom: 12px;">
            <a class="button primary" href="{{ path('app_game_new') }}">Crear juego</a>
        </div>

        {% if games is empty %}
            <p class="subtitle">No hay juegos registrados.</p>
        {% else %}
            <div class="catalog-grid" style="margin-bottom: 24px;">
                {% for game in games %}
                    <div class="list-item">
                        <div>
                            <div class="list-title">{{ game.name }}</div>
                        </div>
                        <div class="actions-row">
                            <a class="button ghost" href="{{ path('app_game_edit', {'id': game.id}) }}">Editar</a>
                            <form method="post" action="{{ path('app_game_delete', {'id': game.id}) }}" onsubmit="return confirm('Seguro que deseas eliminar este juego?');">
                                <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ game.id) }}">
                                <button class="button ghost" type="submit">Eliminar</button>
                            </form>
                        </div>
                    </div>
                {% endfor %}
            </div>
        {% endif %}

        <h2 class="title" style="font-size: 24px; margin-top: 0;">Torneos</h2>
        {% if tournaments is empty %}
            <p class="subtitle">No hay torneos registrados.</p>
        {% else %}
            <div class="catalog-grid">
                {% for tournament in tournaments %}
                    {% set meta = tournament_meta[tournament.id]|default({'participant_count': 0, 'status_label': 'Abierto', 'status_class': 'status-pill status-open'}) %}
                    <div class="list-item">
                        <div>
                            <div class="list-title">{{ tournament.name }}</div>
                            <div class="meta">Juego: {{ tournament.game ? tournament.game.name : 'Sin juego' }}</div>
                            <div class="meta">Creador: {{ tournament.organizer ? tournament.organizer.username : 'Sin creador' }}</div>
                            <div class="meta">{{ meta.participant_count }}/{{ tournament.maxParticipants }} inscritos</div>
                        </div>
                        <div class="actions-row">
                            <span class="{{ meta.status_class }}">{{ meta.status_label }}</span>
                            <a class="button ghost" href="{{ path('app_tournament_show', {'id': tournament.id}) }}">Ver</a>
                            <form method="post" action="{{ path('app_admin_tournament_delete', {'id': tournament.id}) }}" onsubmit="return confirm('Seguro que deseas eliminar este torneo?');">
                                <input type="hidden" name="_token" value="{{ csrf_token('admin_delete_tournament' ~ tournament.id) }}">
                                <button class="button ghost" type="submit">Eliminar</button>
                            </form>
                        </div>
                    </div>
                {% endfor %}
            </div>
        {% endif %}
    </div>
{% endblock %}