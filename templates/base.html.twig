<!DOCTYPE html>
<html lang="es">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1">
        <title>{% block title %}TournamentFlow{% endblock %}</title>
        <link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 128 128%22><text y=%221.1em%22 font-size=%2290%22>⚫️</text><text y=%221.25em%22 x=%220.2em%22 font-size=%2270%22 fill=%22%23fff%22>tf</text></svg>">
        <link rel="preconnect" href="https://fonts.googleapis.com">
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
        <link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@500;600;700&family=Work+Sans:wght@400;500;600&display=swap" rel="stylesheet">
        {% block stylesheets %}
        <style>
            :root {
                color-scheme: light;
                --bg: #f5f2ec;
                --bg-accent: #efe6d6;
                --card: #ffffff;
                --ink: #1e1b18;
                --muted: #5f5a54;
                --primary: #0b8f87;
                --primary-strong: #0a6f6a;
                --accent: #ff8a3d;
                --border: rgba(30, 27, 24, 0.12);
                --shadow: 0 18px 45px rgba(19, 16, 12, 0.12);
                --radius: 20px;
            }

            * {
                box-sizing: border-box;
            }

            body {
                margin: 0;
                font-family: "Work Sans", system-ui, sans-serif;
                color: var(--ink);
                background:
                    radial-gradient(circle at 15% -10%, rgba(11, 143, 135, 0.22), transparent 50%),
                    radial-gradient(circle at 85% 10%, rgba(255, 138, 61, 0.2), transparent 50%),
                    linear-gradient(160deg, var(--bg), var(--bg-accent));
                min-height: 100vh;
            }

            a {
                color: inherit;
                text-decoration: none;
            }

            .page {
                min-height: 100vh;
                display: flex;
                flex-direction: column;
            }

            .site-header {
                display: flex;
                align-items: center;
                justify-content: space-between;
                gap: 12px;
                padding: 18px 20px 10px;
                position: sticky;
                top: 0;
                background: linear-gradient(180deg, rgba(245, 242, 236, 0.9), rgba(245, 242, 236, 0.6));
                backdrop-filter: blur(12px);
                z-index: 10;
            }

            .header-left {
                display: flex;
                align-items: center;
                gap: 10px;
            }

            .back-button {
                width: 36px;
                height: 36px;
                border-radius: 12px;
                border: 1px solid var(--border);
                background: rgba(255, 255, 255, 0.8);
                display: inline-flex;
                align-items: center;
                justify-content: center;
                font-size: 18px;
            }

            .brand {
                font-family: "Space Grotesk", sans-serif;
                font-weight: 700;
                font-size: 20px;
                letter-spacing: -0.02em;
            }

            .nav-links {
                display: flex;
                gap: 8px;
                font-size: 13px;
                flex-wrap: wrap;
                justify-content: flex-end;
            }

            .nav-pill {
                padding: 8px 12px;
                border-radius: 999px;
                background: rgba(255, 255, 255, 0.7);
                border: 1px solid var(--border);
                backdrop-filter: blur(6px);
                font-weight: 600;
            }

            main {
                flex: 1;
                padding: 16px 20px 40px;
            }

            .card {
                background: var(--card);
                border-radius: var(--radius);
                padding: 22px;
                box-shadow: var(--shadow);
                border: 1px solid var(--border);
            }

            .title {
                font-family: "Space Grotesk", sans-serif;
                font-size: 28px;
                margin: 0 0 12px;
                letter-spacing: -0.02em;
            }

            .subtitle {
                color: var(--muted);
                margin: 0 0 20px;
                font-size: 15px;
                line-height: 1.5;
            }

            .button {
                display: inline-flex;
                align-items: center;
                justify-content: center;
                padding: 12px 18px;
                border-radius: 14px;
                font-weight: 600;
                font-size: 15px;
                border: none;
                cursor: pointer;
            }

            .button.primary {
                background: var(--primary);
                color: #fff;
            }

            .button.primary:hover {
                background: var(--primary-strong);
            }

            .button.ghost {
                background: transparent;
                border: 1px solid var(--border);
                color: var(--ink);
            }

            .form-grid {
                display: grid;
                gap: 12px;
            }

            .form-field {
                display: grid;
                gap: 6px;
                font-size: 14px;
            }

            .form-field input {
                padding: 12px 14px;
                border-radius: 12px;
                border: 1px solid var(--border);
                font-size: 15px;
            }

            .form-field textarea,
            .form-field select {
                padding: 12px 14px;
                border-radius: 12px;
                border: 1px solid var(--border);
                font-size: 15px;
                background: #fff;
            }

            .list-header {
                display: flex;
                flex-direction: column;
                gap: 12px;
                margin-bottom: 16px;
            }

            .list {
                display: grid;
                gap: 12px;
            }

            .list-item {
                display: flex;
                align-items: center;
                justify-content: space-between;
                gap: 12px;
                padding: 14px 16px;
                border-radius: 16px;
                border: 1px solid var(--border);
                background: #fff;
            }

            .list-title {
                font-weight: 600;
                font-size: 16px;
                margin-bottom: 4px;
            }

            .meta {
                color: var(--muted);
                font-size: 13px;
            }

            .chip {
                padding: 6px 10px;
                border-radius: 999px;
                background: rgba(11, 143, 135, 0.12);
                color: var(--primary-strong);
                font-size: 12px;
                font-weight: 600;
            }

            .actions-row {
                display: grid;
                gap: 10px;
                margin-top: 16px;
            }

            .notice {
                background: rgba(255, 138, 61, 0.12);
                border: 1px solid rgba(255, 138, 61, 0.4);
                color: #6c3a16;
                padding: 10px 12px;
                border-radius: 12px;
                font-size: 13px;
                margin-bottom: 14px;
            }

            @media (min-width: 768px) {
                main {
                    max-width: 720px;
                    margin: 0 auto;
                }

                .title {
                    font-size: 34px;
                }
            }
        </style>
        {% endblock %}

        {% block javascripts %}
        {% endblock %}

        {% set frankenphpHotReload = app.request.server.get('FRANKENPHP_HOT_RELOAD') %}
        {% if frankenphpHotReload %}
        <meta name="frankenphp-hot-reload:url" content="{{ frankenphpHotReload }}">
        <script src="https://cdn.jsdelivr.net/npm/idiomorph"></script>
        <script src="https://cdn.jsdelivr.net/npm/frankenphp-hot-reload/+esm" type="module"></script>
        {% endif %}
    </head>
    <body>
        <div class="page">
            <header class="site-header">
                <div class="header-left">
                    {% set fallback = app.user ? path('app_home') : path('app_landing') %}
                    {% set referer = app.request.headers.get('referer') %}
                    {% set safeBack = referer and (referer starts with app.request.schemeAndHttpHost) ? referer : fallback %}
                    <a class="back-button" href="{{ safeBack }}" aria-label="Volver">←</a>
                    <a class="brand" href="{{ app.user ? path('app_home') : path('app_landing') }}">TournamentFlow</a>
                </div>
                <nav class="nav-links">
                    {% if app.user %}
                        <a class="nav-pill" href="{{ path('app_home') }}">Inicio</a>
                        <a class="nav-pill" href="{{ path('app_tournament_index') }}">Torneos</a>
                        <a class="nav-pill" href="{{ path('app_game_index') }}">Juegos</a>
                    {% else %}
                        <a class="nav-pill" href="{{ path('app_login') }}">Login</a>
                        <a class="nav-pill" href="{{ path('app_register') }}">Registro</a>
                    {% endif %}
                </nav>
            </header>
            <main>
                {% block body %}{% endblock %}
            </main>
        </div>
    </body>
</html>
