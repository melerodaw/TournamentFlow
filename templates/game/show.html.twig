{% extends 'base.html.twig' %}

{% block title %}Detalle de juego | TournamentFlow{% endblock %}

{% block body %}
    <div class="card">
        <h1 class="title">{{ game.name }}</h1>
        <p class="subtitle">{{ game.imageUrl ?: 'Sin imagen cargada.' }}</p>

        <div class="actions-row">
            <a class="button ghost" href="{{ path('app_game_index') }}">Volver</a>
            <a class="button primary" href="{{ path('app_game_edit', {'id': game.id}) }}">Editar</a>
            {{ include('game/_delete_form.html.twig') }}
        </div>
    </div>
{% endblock %}
