{% extends 'base.html.twig' %}

{% block title %}Registro | TournamentFlow{% endblock %}

{% block body %}
<div class="card">
    <h1 class="title">Crea tu cuenta</h1>
    <p class="subtitle">Un par de datos y podras crear tu primer torneo.</p>

    {{ form_start(registrationForm, { attr: { class: 'form-grid' } }) }}
        <div class="form-field">
            {{ form_label(registrationForm.username) }}
            {{ form_widget(registrationForm.username) }}
            {{ form_errors(registrationForm.username) }}
        </div>
        <div class="form-field">
            {{ form_label(registrationForm.email) }}
            {{ form_widget(registrationForm.email) }}
            {{ form_errors(registrationForm.email) }}
        </div>
        <div class="form-field">
            {{ form_label(registrationForm.plainPassword) }}
            {{ form_widget(registrationForm.plainPassword) }}
            {{ form_errors(registrationForm.plainPassword) }}
        </div>

        <button class="button primary" type="submit">Crear cuenta</button>
        <a class="button ghost" href="{{ path('app_login') }}">Ya tengo cuenta</a>
    {{ form_end(registrationForm) }}
</div>
{% endblock %}
