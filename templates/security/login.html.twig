{% extends 'base.html.twig' %}

{% block title %}Login | TournamentFlow{% endblock %}

{% block body %}
<section class="hero-surface" style="min-height: calc(100vh - 90px);">
    <div class="shell" style="max-width: 520px;">
        <div class="hero-login-float">
            <span class="section-label">Acceso</span>
            <h1 class="title">Bienvenido de nuevo</h1>
            <p class="subtitle">Accede a tu panel y sigue gestionando torneos.</p>

            {% if error %}
                <div class="notice notice-error">{{ error.messageKey|trans(error.messageData, 'security') }}</div>
            {% endif %}

            <form method="post" class="form-grid">
                <div class="form-field">
                    <label for="inputUsername">Usuario</label>
                    <input type="text" value="{{ last_username }}" name="username" id="inputUsername" autocomplete="username" required autofocus>
                </div>
                <div class="form-field">
                    <label for="inputPassword">Contraseña</label>
                    <input type="password" name="password" id="inputPassword" autocomplete="current-password" required>
                </div>
                <input type="hidden" name="_csrf_token" data-controller="csrf-protection" value="{{ csrf_token('authenticate') }}">

                <button class="button primary" type="submit">Entrar</button>
                <a class="button ghost" href="{{ path('app_register') }}">Crear cuenta</a>
            </form>
        </div>
    </div>
</section>
{% endblock %}
