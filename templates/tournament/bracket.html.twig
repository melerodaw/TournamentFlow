{% extends 'base.html.twig' %}

{% block title %}Bracket — {{ tournament.name }}{% endblock %}

{% block body %}
    <div class="card">
        <h1 class="title">Bracket — {{ tournament.name }}</h1>
        <p class="subtitle">Formato: {{ tournament.format }}</p>

        {% if tournament.status == 'finished' and tournament.champion %}
            <div class="bracket-banner">🏆 {{ tournament.champion.user.username }} es el campeón de este torneo</div>
        {% endif %}

        <div id="bracket-root" class="bracket" style="position:relative; display:flex; gap:24px; overflow:auto; padding: 16px; align-items:flex-start;">
            <svg id="bracket-connectors" style="position:absolute; left:0; top:0; width:100%; height:100%; pointer-events:none; overflow:visible;"></svg>
            {% for number, matches in rounds %}
                <div class="round-column" data-round="{{ number }}" style="min-width:220px; position:relative;">
                    <h3>Ronda {{ number }}</h3>
                    {% for match in matches %}
                        <div class="match-card{{ tournament.champion and match.winner and tournament.champion.id == match.winner.id ? ' is-champion' : '' }}" data-round="{{ number }}" data-slot="{{ match.slot }}" data-match-id="{{ match.id }}" style="border:1px solid #ddd; padding:8px; margin-bottom:24px; border-radius:6px; background: #fff; position:relative;">
                            <div style="font-weight: {{ match.winner ? '700' : '400' }};">
                                <div>{{ match.participant1 ? match.participant1.user.username : 'Por determinar' }}</div>
                                <div style="opacity:0.75; font-size:12px;">vs</div>
                                <div>{{ match.participant2 ? match.participant2.user.username : 'Por determinar' }}</div>
                            </div>
                            {% if match.winner %}
                                <div style="margin-top:6px; color: #b8860b; font-weight:700;">Ganador: {{ match.winner.user.username }}</div>
                            {% elseif app.user and (tournament.organizer and app.user.id == tournament.organizer.id or is_granted('ROLE_ADMIN')) and match.participant1 and match.participant2 %}
                                <div style="display:flex; gap:8px; margin-top:8px;">
                                    <form method="post" action="{{ path('app_tournament_match_result', {'id': tournament.id, 'matchId': match.id}) }}">
                                        <input type="hidden" name="winner_id" value="{{ match.participant1.id }}">
                                        <button class="button" type="submit">{{ match.participant1.user.username }}</button>
                                    </form>
                                    <form method="post" action="{{ path('app_tournament_match_result', {'id': tournament.id, 'matchId': match.id}) }}">
                                        <input type="hidden" name="winner_id" value="{{ match.participant2.id }}">
                                        <button class="button" type="submit">{{ match.participant2.user.username }}</button>
                                    </form>
                                </div>
                            {% endif %}
                        </div>
                    {% endfor %}
                </div>
            {% endfor %}
        </div>

        <script>
            document.addEventListener('DOMContentLoaded', function () {
                const svg = document.getElementById('bracket-connectors');
                const root = document.getElementById('bracket-root');
                function drawConnectors() {
                    while (svg.firstChild) svg.removeChild(svg.firstChild);
                    const rounds = Array.from(root.querySelectorAll('.round-column'));
                    for (let i = 0; i < rounds.length - 1; i++) {
                        const current = rounds[i];
                        const next = rounds[i + 1];
                        const matches = Array.from(current.querySelectorAll('.match-card'));
                        matches.forEach(match => {
                            const slot = parseInt(match.dataset.slot || '0', 10);
                            const targetSlot = Math.floor(slot / 2);
                            const nextMatches = Array.from(next.querySelectorAll('.match-card'));
                            const target = nextMatches.find(m => parseInt(m.dataset.slot||'0',10) === targetSlot);
                            if (!target) return;
                            const r = root.getBoundingClientRect();
                            const a = match.getBoundingClientRect();
                            const b = target.getBoundingClientRect();
                            const startX = a.right - r.left;
                            const startY = a.top + a.height / 2 - r.top;
                            const endX = b.left - r.left;
                            const endY = b.top + b.height / 2 - r.top;
                            const path = document.createElementNS('http://www.w3.org/2000/svg','path');
                            const dx = Math.abs(endX - startX) * 0.5;
                            const d = `M ${startX} ${startY} C ${startX + dx} ${startY} ${endX - dx} ${endY} ${endX} ${endY}`;
                            path.setAttribute('d', d);
                            path.setAttribute('stroke', '#999');
                            path.setAttribute('fill', 'none');
                            path.setAttribute('stroke-width', '2');
                            svg.appendChild(path);
                        });
                    }
                }
                drawConnectors();
                window.addEventListener('resize', drawConnectors);
            });
        </script>
    </div>
{% endblock %}
