{% extends 'base.html.twig' %}

{% block title %}Detalle de torneo | TournamentFlow{% endblock %}

{% block body %}
    {% set format_labels = {
        'single_elim': 'Eliminacion simple',
        'swiss': 'Suizo',
        'round_robin': 'Round robin'
    } %}
    {% set status_labels = {
        'draft': 'Borrador',
        'open': 'Abierto',
        'running': 'En curso',
        'completed': 'Finalizado',
        'canceled': 'Cancelado'
    } %}

    <div class="card">
        <div class="breadcrumbs">
            <a href="{{ path('app_home') }}">Inicio</a>
            <span class="crumb-sep">&gt;</span>
            <a href="{{ path('app_tournament_index') }}">Torneos</a>
            <span class="crumb-sep">&gt;</span>
            <span>{{ tournament.name }}</span>
        </div>

        <h1 class="title">{{ tournament.name }}</h1>
        <p class="subtitle">{{ tournament.description ?: 'Sin descripcion.' }}</p>

        <div class="list">
            <div class="list-item">
                <div>
                    <div class="list-title">Juego</div>
                    <div class="media-row">
                        <img class="media-thumb" src="/{{ tournament.game and tournament.game.imagePath ? tournament.game.imagePath : 'images/games/placeholder.svg' }}" alt="{{ tournament.game ? tournament.game.name }}">
                        <div class="meta">{{ tournament.game ? tournament.game.name : 'Sin juego' }}</div>
                    </div>
                </div>
            </div>
            <div class="list-item">
                <div>
                    <div class="list-title">Fecha</div>
                    <div class="meta">{{ tournament.startAt ? tournament.startAt|date('d M Y H:i') : 'Sin fecha' }}</div>
                </div>
            </div>
            <div class="list-item">
                <div>
                    <div class="list-title">Creado por</div>
                    <div class="meta">{{ tournament.organizer.username }}</div>
                </div>
            </div>
            <div class="list-item">
                <div>
                    <div class="list-title">Participantes</div>
                    <div class="meta">{{ participant_count }}/{{ tournament.maxParticipants }} participantes inscritos</div>
                </div>
            </div>
            <div class="list-item">
                <div>
                    <div class="list-title">Estado</div>
                    <span class="{{ computed_status_class }}">{{ computed_status_label }}</span>
                </div>
            </div>
            <div class="list-item">
                <div>
                    <div class="list-title">Formato</div>
                    <div class="meta">{{ format_labels[tournament.format]|default(tournament.format) }}</div>
                </div>
            </div>
            <div class="list-item">
                <div>
                    <div class="list-title">Cierre de inscripción</div>
                    <div class="meta">{{ tournament.registrationDeadlineAt ? tournament.registrationDeadlineAt|date('d M Y H:i') : 'Sin fecha' }}</div>
                </div>
            </div>
        </div>

        {% if is_registered %}
            <div class="notice">Ya estás inscrito.</div>
        {% elseif can_join %}
            <form method="post" action="{{ path('app_tournament_join', {'id': tournament.id}) }}">
                <input type="hidden" name="_token" value="{{ csrf_token('join' ~ tournament.id) }}">
                <button class="button primary" type="submit">Unirse al torneo</button>
            </form>
        {% endif %}

        {% if is_registered %}
            <div class="list" style="margin-top: 18px;">
                <div class="list-item">
                    <div>
                        <div class="list-title">Lista de participantes inscritos</div>
                        {% if participants is empty %}
                            <div class="meta">Todavía no hay participantes inscritos.</div>
                        {% else %}
                            <div class="form-grid" style="margin-top: 10px;">
                                {% for participant in participants %}
                                    <div class="meta">{{ participant.user.username }}</div>
                                {% endfor %}
                            </div>
                        {% endif %}
                    </div>
                </div>
            </div>
        {% endif %}

        <div class="actions-row">
            <a class="button ghost" href="{{ path('app_tournament_index') }}">Volver</a>
            {% if can_manage %}
                <a class="button primary" href="{{ path('app_tournament_edit', {'id': tournament.id}) }}">Editar</a>
                {{ include('tournament/_delete_form.html.twig') }}
            {% endif %}
        </div>
    </div>
{% endblock %}
